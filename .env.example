# Public origin of this deployment, e.g. the production domain once registered. Used to build
# absolute URLs in page metadata. Leave empty locally; set per environment in the host's settings.
NEXT_PUBLIC_SITE_URL=

# Supabase API URL. Locally: "API URL" from `supabase status`. Hosted: Project Settings, API.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...), safe for the browser because row level security
# applies. Locally: "Publishable key" from `supabase status`. Hosted: Project Settings, API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase service role key. Secret, server only, bypasses row level security; never prefix it
# with NEXT_PUBLIC_. Locally: SERVICE_ROLE_KEY from `supabase status -o env`. Hosted: Project
# Settings, API Keys.
SUPABASE_SERVICE_ROLE_KEY=

# Key that encrypts stored provider credentials (AES-256-GCM). Secret, server only, never prefix
# with NEXT_PUBLIC_, never store it in the database. Base64 of exactly 32 random bytes; generate
# one with `openssl rand -base64 32`. Losing it means every connection must reconnect.
DEVMACRO_ENCRYPTION_KEY=
# Previous keys kept readable during rotation, comma separated as keyId:base64Key, where keyId is
# the first 8 hex characters of the SHA-256 of the key. Leave empty unless rotating; see the
# header of scripts/rotate-encryption-key.ts and run `npm run keys:rotate`.
DEVMACRO_ENCRYPTION_KEYS_PREVIOUS=

# GitHub OAuth app for signing in to DevMacro (not the GitHub App that reads billing data). Register
# one at https://github.com/settings/developers with the authorization callback URL
# http://127.0.0.1:55421/auth/v1/callback locally (hosted: https://<project-ref>.supabase.co/auth/v1/callback).
# Read by the Supabase CLI, not by Next.js: put these two in supabase/.env.local (git ignored) or
# export them before `supabase start`. The CLI refuses to start without them because the GitHub
# provider is enabled; any placeholder works when you only run the e2e suite, which never signs
# in through GitHub. Hosted: Authentication, Sign In / Providers, GitHub in the Supabase dashboard.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
