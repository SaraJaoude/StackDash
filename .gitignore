# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/e2e/.results/
# Signed-in session cookies minted by e2e/global-setup.ts
/e2e/.auth/
/playwright-report/
/pr-evidence/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase cli local state
/supabase/.branches
/supabase/.temp
# A private JWT signing key, if you set auth.signing_keys_path (supabase/config.toml)
/supabase/signing_keys.json
